<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisonke_Banking_App.CreateAccount">
    <ContentPage.Content>
        <StackLayout>
            <Entry x:Name="txtHolderName" Placeholder="Holder Name" ReturnType="Next" TextColor="Black" PlaceholderColor="Black"></Entry>
            <Entry x:Name="txtSurname" Placeholder="Surname" ReturnType="Next" TextColor="Black" PlaceholderColor="Black"></Entry>
            <Entry x:Name="txtBalance" Placeholder="Balance" ReturnType="Next" Keyboard="Numeric"  TextColor="Black" PlaceholderColor="Black"></Entry>
            <Entry x:Name="txtSavingsAccountBalance" ReturnType="Next" Placeholder="Savings Account Balance"  Keyboard="Numeric" TextColor="Black" PlaceholderColor="Black"></Entry>


            <Button
                Text="Create Account"
                TextColor="GhostWhite"
                BackgroundColor="Black"
                BorderColor="Black"
                Clicked="Button_Clicked"
                ></Button>
            <CollectionView x:Name="listAccounts">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout>
                            <Entry Text="{Binding Id}" FontSize="10"/>
                            <Entry Text="{Binding HolderName}"  FontAttributes="Bold" FontSize="Title" />
                            <Entry Text="{Binding Surname}" FontSize="Medium" FontAttributes="Bold"  />
                            <Entry Text="{Binding Balance}" FontSize="Medium" FontAttributes="Bold"/>
                            <Entry Text="{Binding SavingsAccountBalance}" FontSize="Medium" FontAttributes="Bold"/>

                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>