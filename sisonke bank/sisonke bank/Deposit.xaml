<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisonke_Banking_App.Deposit">
    <ContentPage.Content>
        <StackLayout>
            <Frame BackgroundColor="#2196F3"  Padding="24" CornerRadius="0">
                <Label Text="Sisonke Bank" HorizontalTextAlignment="Center" TextColor="White" FontSize="36"/>
            </Frame>

            <Entry Placeholder="Account Number" Keyboard="Numeric" ReturnType="Next" BackgroundColor="GhostWhite" TextColor="Black" x:Name="txtAccountNumber" />
            <Entry Placeholder="Deposit Amount" Keyboard="Numeric" ReturnType="Next" BackgroundColor="GhostWhite" TextColor="Black" x:Name="txtDepositAmount" />
            
            <Button Text="Deposit" TextColor="GhostWhite" BackgroundColor="Black" BorderColor="Black" Clicked="Button_Clicked">
            </Button>
            
        </StackLayout>
    </ContentPage.Content>
</ContentPage>