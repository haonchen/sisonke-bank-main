<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sisonke_Banking_App.LogInPage">
    <ContentPage.Content>
        <StackLayout>
            <Frame BackgroundColor="#000000"  Padding="24" CornerRadius="0" >
                <Label Text="Log In" FontAttributes="Italic" HorizontalTextAlignment="Center" TextColor="White" FontSize="36"/>
            </Frame>

          
            <Entry x:Name="txtEmail" ReturnType="Next" Placeholder="Email" BackgroundColor="GhostWhite" Keyboard="Email" TextColor="Black" PlaceholderColor="Black"></Entry>
            <Entry x:Name="txtPassword" Placeholder="Password" IsPassword="True" Keyboard="Numeric" PlaceholderColor="Black"></Entry>
            <Button
                VerticalOptions="Center"
                Text="Login"
                x:Name="BtnLogInPage"
                TextColor="GhostWhite"
                BackgroundColor="Black"
                BorderColor="Black"
                BorderWidth="0.5"
                CornerRadius="20"
                Clicked="BtnLogInPage_Clicked"
                ></Button>

            <Label HorizontalOptions="Center">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Go Back To " TextColor="Black" />
                        <Span Text="Welcome Page? " TextColor="Black" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>